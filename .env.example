LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
MAX_LLM_CHARS=6000
OCR_CONFIDENCE_THRESHOLD=0.6
MAX_RETRY_COUNT=3
DOCX_TO_PDF=false
UPLOAD_MAX_MB=50
MAX_PDF_PAGES=200
HEADING_SCORE_THRESHOLD=60
HEADING_MAX_LENGTH=60
CLAUSE_KEYWORDS=付款条款,交付条款,验收条款,违约条款,保密条款,数据条款,知识产权条款,争议解决条款

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=contract_review
DB_CHARSET=utf8mb4

APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-secret-key-2026
TOKEN_EXPIRE_MINUTES=120
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

APPROVAL_ADAPTER=mock
MOCK_DATA_DIR=mock
# MySQL 镜像：国内源默认 daocloud 代理；官方源可改为 mysql:8
MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8
# 目录支持两种写法：绝对路径，或相对路径（自动基于项目根目录解析）
UPLOAD_DIR=uploads
LOG_DIR=logs

# 预留：三个 LLM 代理可分别指定模型
# LLM_PARSE_MODEL=
# LLM_RULE_MODEL=
# LLM_WRITEBACK_MODEL=
